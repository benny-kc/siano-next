{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus data source your Grafana Alloy/Agent remote_writes the Siano hub metrics into.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Operational dashboard for the Siano sync hub (dependency-free Node relay). Built on the /metrics endpoint from hub/metrics.js.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["siano", "hub"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(siano_up, job)", "refId": "SianoJobVar" },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"], "selected": false },
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(siano_up{job=~\"$job\"}, instance)", "refId": "SianoInstanceVar" },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"], "selected": false },
        "hide": 0
      },
      {
        "name": "trip",
        "label": "Trip",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(siano_trip_ops{job=~\"$job\", instance=~\"$instance\"}, trip)", "refId": "SianoTripVar" },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"], "selected": false },
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Siano Hub",
  "uid": "siano-hub",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Hub status",
      "description": "1 if the hub is serving. Red = down or no data scraped.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "min(siano_up{job=~\"$job\", instance=~\"$instance\"})", "instant": true, "legendFormat": "up" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "noValue": "DOWN", "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max(siano_uptime_seconds{job=~\"$job\", instance=~\"$instance\"})", "instant": true, "legendFormat": "uptime" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Live connections",
      "description": "Currently open WebSocket connections (summed across selected hubs).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(siano_ws_connections{job=~\"$job\", instance=~\"$instance\"})", "instant": true, "legendFormat": "connections" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Active trips",
      "description": "Trips with at least one live connection.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(siano_trips_active{job=~\"$job\", instance=~\"$instance\"})", "instant": true, "legendFormat": "active" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Trips on disk",
      "description": "Trip logs persisted (siano_trips_total).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 6,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max(siano_trips_total{job=~\"$job\", instance=~\"$instance\"})", "instant": true, "legendFormat": "total" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Op append rate",
      "description": "Ops accepted into logs per second (across selected hubs).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 7,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(siano_ops_appended_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "instant": true, "legendFormat": "ops/s" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 8,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Op throughput (appended vs rejected)",
      "description": "Rejected = duplicate op or a per-trip / global cap hit. A rising rejected line usually means dedup churn or a trip approaching its op cap.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 9,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(siano_ops_appended_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "appended" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(siano_ops_rejected_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "rejected" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "showPoints": "never", "lineWidth": 2, "axisLabel": "ops/s" }, "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "rejected" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Client messages",
      "description": "Frames parsed as JSON objects per second.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 10,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(siano_messages_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "messages" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "mps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "showPoints": "never", "lineWidth": 2, "axisLabel": "msg/s" }, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Connection churn (open / close per sec)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 11,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(siano_ws_opened_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "opened" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(siano_ws_closed_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "closed" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Concurrency (connections & active trips)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 12,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(siano_ws_connections{job=~\"$job\", instance=~\"$instance\"})", "legendFormat": "connections" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(siano_trips_active{job=~\"$job\", instance=~\"$instance\"})", "legendFormat": "active trips" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Errors & abuse",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 13,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Rate-limit closes",
      "description": "Connections closed (1008) for exceeding SIANO_MAX_MSGS_PER_SEC. Sustained non-zero = a chatty/abusive client or a limit set too low.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 23 },
      "id": 14,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(siano_rate_limit_closes_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "closes/s" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "single", "sort": "none" } },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "bars", "fillOpacity": 60, "showPoints": "never", "lineWidth": 1 }, "color": { "mode": "fixed", "fixedColor": "orange" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Bad JSON frames",
      "description": "Frames that failed to parse. A spike often means a broken/hostile client or a protocol mismatch.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 23 },
      "id": 15,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(siano_bad_json_total{job=~\"$job\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "bad/s" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "single", "sort": "none" } },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "bars", "fillOpacity": 60, "showPoints": "never", "lineWidth": 1 }, "color": { "mode": "fixed", "fixedColor": "yellow" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "WS upgrade rejections by reason",
      "description": "Refused WebSocket upgrades (Origin allowlist, connection cap, bad request, …).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 23 },
      "id": 16,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (reason) (rate(siano_ws_upgrade_rejected_total{job=~\"$job\", instance=~\"$instance\", reason!=\"none\"}[$__rate_interval]))", "legendFormat": "{{reason}}" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "bars", "fillOpacity": 70, "showPoints": "never", "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Per-trip",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 17,
      "panels": []
    },
    {
      "type": "table",
      "title": "Top trips by ops (in memory)",
      "description": "Largest trip logs currently held in memory. Watch these against SIANO_MAX_OPS_PER_TRIP.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 31 },
      "id": 18,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "topk(15, sum by (trip) (siano_trip_ops{job=~\"$job\", instance=~\"$instance\", trip=~\"$trip\"}))", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true, "__name__": true }, "renameByName": { "trip": "Trip", "Value": "Ops" } } },
        { "id": "sortBy", "options": { "fields": "", "sort": [ { "field": "Ops", "desc": true } ] } }
      ],
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Ops" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }, { "id": "color", "value": { "mode": "continuous-GrYlRd" } } ] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Per-trip live connections",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 31 },
      "id": 19,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (trip) (siano_trip_connections{job=~\"$job\", instance=~\"$instance\", trip=~\"$trip\"}) > 0", "legendFormat": "{{trip}}" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Per-trip op append rate",
      "description": "How fast each trip is accumulating ops (write activity).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "id": 20,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (trip) (rate(siano_trip_ops_appended_total{job=~\"$job\", instance=~\"$instance\", trip=~\"$trip\"}[$__rate_interval])) > 0", "legendFormat": "{{trip}}" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Process",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "id": 21,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Memory (RSS & V8 heap)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 49 },
      "id": 22,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "siano_process_resident_memory_bytes{job=~\"$job\", instance=~\"$instance\"}", "legendFormat": "{{instance}} rss" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "siano_process_heap_used_bytes{job=~\"$job\", instance=~\"$instance\"}", "legendFormat": "{{instance}} heap" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    }
  ]
}
