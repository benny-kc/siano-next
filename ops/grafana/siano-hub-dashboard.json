      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 58 },
      "id": 16,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Rate-limit closes per hub",
      "description": "Connections closed (1008) for exceeding SIANO_MAX_MSGS_PER_SEC.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 59 },
      "id": 17,
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_rate_limit_closes_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}}" } ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "bars", "fillOpacity": 60, "showPoints": "never", "lineWidth": 1 }, "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Bad JSON frames per hub",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 59 },
      "id": 18,
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_bad_json_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}}" } ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "bars", "fillOpacity": 60, "showPoints": "never", "lineWidth": 1 }, "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "WS upgrade rejections (hub / reason)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 59 },
      "id": 19,
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub, reason) (rate(siano_ws_upgrade_rejected_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\", reason!=\"none\"}[$__rate_interval]))", "legendFormat": "{{hub}} · {{reason}}" } ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "bars", "fillOpacity": 70, "showPoints": "never", "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } }, "color": { "mode": "palette-classic" } }, "overrides": [] }
    },

    {
      "type": "row",
      "title": "Per-trip (across hubs)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 66 },
      "id": 20,
      "panels": []
    },
    {
      "type": "table",
      "title": "Top trips by ops",
      "description": "Largest trip logs in memory, merged across hubs. Watch against SIANO_MAX_OPS_PER_TRIP.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 67 },
      "id": 21,
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "topk(15, max by (trip) (siano_trip_ops{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\", trip=~\"$trip\"}))", "instant": true, "format": "table" } ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true, "hub": true, "os": true, "__name__": true, "__proxy_source__": true }, "renameByName": { "trip": "Trip", "Value": "Ops" } } },
        { "id": "sortBy", "options": { "fields": "", "sort": [ { "field": "Ops", "desc": true } ] } }
      ],
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "filterable": true } }, "overrides": [ { "matcher": { "id": "byName", "options": "Ops" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }, { "id": "color", "value": { "mode": "continuous-GrYlRd" } } ] } ] }
    },
    {
      "type": "timeseries",
      "title": "Per-trip live connections",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 67 },
      "id": 22,
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (trip) (siano_trip_connections{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\", trip=~\"$trip\"}) > 0", "legendFormat": "{{trip}}" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Per-trip op append rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 76 },
      "id": 23,
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (trip) (rate(siano_trip_ops_appended_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\", trip=~\"$trip\"}[$__rate_interval])) > 0", "legendFormat": "{{trip}}" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } }, "overrides": [] }
    },

    {
      "type": "row",
      "title": "Process (per hub)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 84 },
      "id": 24,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Node process memory per hub (RSS & V8 heap)",
      "description": "The hub process itself (siano_process_*), distinct from whole-host memory above.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 85 },
      "id": 25,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max by (hub) (siano_process_resident_memory_bytes{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"})", "legendFormat": "{{hub}} rss" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max by (hub) (siano_process_heap_used_bytes{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"})", "legendFormat": "{{hub}} heap" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*heap" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } } ] } ] }
    },

    {
      "type": "row",
      "title": "Hub-to-hub sync (peer link)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 92 },
      "id": 40,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Peer link status",
      "description": "1 if the dialing hub has an open WebSocket link to a peer hub (per dialer→peer pair). Only the hub that dials reports this. Empty on a single-hub / star-central deployment.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 93 },
      "id": 41,
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max by (hub, peer) (siano_peer_link_up{hub=~\"$hub\"})", "instant": true, "legendFormat": "{{hub}} → {{peer}}" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "index": 0 } } }, { "type": "value", "options": { "1": { "text": "UP", "index": 1 } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }, "color": { "mode": "thresholds" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Inbound peer connections",
      "description": "Peer hubs currently dialed INTO this hub (the acceptor side).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 93 },
      "id": 42,
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (siano_peer_inbound_connections{hub=~\"$hub\"})", "instant": true, "legendFormat": "{{hub}}" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Configured peers",
      "description": "Peer URLs each hub is configured to dial (siano_peer_configured).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 93 },
      "id": 43,
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max by (hub) (siano_peer_configured{hub=~\"$hub\"})", "instant": true, "legendFormat": "{{hub}}" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Peer op flow (in / out) per sec",
      "description": "Ops replicated over the peer link: ingested FROM peers and forwarded TO peers, per dialing hub.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 97 },
      "id": 44,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_peer_ops_in_total{hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}} in" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_peer_ops_out_total{hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}} out" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 12, "showPoints": "never", "lineWidth": 2, "axisLabel": "ops/s" }, "color": { "mode": "palette-classic" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*out" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } } ] } ] }
    },
    {
      "type": "timeseries",
      "title": "Peer reconnects & auth failures per sec",
      "description": "Link closures that triggered a reconnect, and inbound peer connections rejected for a bad SIANO_PEER_TOKEN. Sustained non-zero = a flapping link or a token mismatch.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 97 },
      "id": 45,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_peer_disconnects_total{hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}} reconnects" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_peer_auth_failures_total{hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}} auth-fail" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "bars", "fillOpacity": 60, "showPoints": "never", "lineWidth": 1 }, "color": { "mode": "palette-classic" } }, "overrides": [] }
    }
  ]
}
