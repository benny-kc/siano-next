{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus data source your Grafana Alloy/Agent remote_writes the Siano hub metrics into. Both hubs write to this one source.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Operational dashboard for the Siano sync hubs (dependency-free Node relay). Fleet totals plus per-hub breakouts by the `hub` label. Built on the /metrics endpoint from hub/metrics.js.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["siano", "hub"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "name": "hub",
        "label": "Hub",
        "description": "Set external_labels { hub = \"hub-a\" } (and hub-b) in each Alloy remote_write so the two hubs are distinguishable.",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(siano_up, hub)", "refId": "SianoHubVar" },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"], "selected": false },
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(siano_up{hub=~\"$hub\"}, job)", "refId": "SianoJobVar" },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"], "selected": false },
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(siano_up{hub=~\"$hub\", job=~\"$job\"}, instance)", "refId": "SianoInstanceVar" },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"], "selected": false },
        "hide": 0
      },
      {
        "name": "trip",
        "label": "Trip",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": { "query": "label_values(siano_trip_ops{hub=~\"$hub\", job=~\"$job\", instance=~\"$instance\"}, trip)", "refId": "SianoTripVar" },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"], "selected": false },
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Siano Hub",
  "uid": "siano-hub",
  "version": 2,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "title": "Fleet overview (all selected hubs)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Hubs online",
      "description": "Number of hubs currently reporting siano_up=1 (out of the selected set).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(siano_up{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"})", "instant": true, "legendFormat": "online" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 2 } ] },
          "noValue": "0", "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Live connections (fleet)",
      "description": "Open WebSocket connections summed across all selected hubs.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(siano_ws_connections{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"})", "instant": true, "legendFormat": "connections" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Active trips (fleet)",
      "description": "Trips with at least one live connection, summed across hubs (a trip live on both hubs counts on each).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(siano_trips_active{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"})", "instant": true, "legendFormat": "active" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Trips on disk (fleet)",
      "description": "Trip logs persisted, summed across hubs.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(siano_trips_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"})", "instant": true, "legendFormat": "total" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Op append rate (fleet)",
      "description": "Ops accepted into logs per second, summed across hubs.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 6,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(siano_ops_appended_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"}[$__rate_interval]))", "instant": true, "legendFormat": "ops/s" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value"
      },
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Per-hub health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 7,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Status per hub",
      "description": "One tile per hub (the `hub` label). Green = up, red = down.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 6 },
      "id": 8,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max by (hub) (siano_up{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"})", "instant": true, "legendFormat": "{{hub}}" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Uptime per hub",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 6 },
      "id": 9,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max by (hub) (siano_uptime_seconds{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"})", "instant": true, "legendFormat": "{{hub}}" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "textMode": "value_and_name"
      },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Connections per hub",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 6 },
      "id": 10,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (siano_ws_connections{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"})", "instant": true, "legendFormat": "{{hub}}" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "textMode": "value_and_name"
      },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "Traffic (per hub)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 11,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Op throughput per hub (appended / rejected)",
      "description": "Rejected = duplicate op or a per-trip / global cap hit.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "id": 12,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_ops_appended_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}} appended" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_ops_rejected_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}} rejected" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 12, "showPoints": "never", "lineWidth": 2, "axisLabel": "ops/s" }, "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*rejected" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } } ] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Client messages per hub",
      "description": "Frames parsed as JSON objects per second.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "id": 13,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_messages_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}}" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "mps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 12, "showPoints": "never", "lineWidth": 2, "axisLabel": "msg/s" }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Connection churn per hub (open / close per sec)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 14,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_ws_opened_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}} opened" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_ws_closed_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}} closed" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*closed" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } } ] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Concurrent connections per hub",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 15,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (siano_ws_connections{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"})", "legendFormat": "{{hub}}" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Errors & abuse (per hub)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 16,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Rate-limit closes per hub",
      "description": "Connections closed (1008) for exceeding SIANO_MAX_MSGS_PER_SEC.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 28 },
      "id": 17,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_rate_limit_closes_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}}" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "bars", "fillOpacity": 60, "showPoints": "never", "lineWidth": 1 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Bad JSON frames per hub",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 28 },
      "id": 18,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub) (rate(siano_bad_json_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"}[$__rate_interval]))", "legendFormat": "{{hub}}" }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "bars", "fillOpacity": 60, "showPoints": "never", "lineWidth": 1 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "WS upgrade rejections (hub / reason)",
      "description": "Refused WebSocket upgrades (Origin allowlist, connection cap, bad request, …).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 28 },
      "id": 19,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (hub, reason) (rate(siano_ws_upgrade_rejected_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\", reason!=\"none\"}[$__rate_interval]))", "legendFormat": "{{hub}} · {{reason}}" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "drawStyle": "bars", "fillOpacity": 70, "showPoints": "never", "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Per-trip (across hubs)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "id": 20,
      "panels": []
    },
    {
      "type": "table",
      "title": "Top trips by ops",
      "description": "Largest trip logs in memory, merged across hubs (a trip peer-synced to both hubs is summed). Watch against SIANO_MAX_OPS_PER_TRIP.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 36 },
      "id": 21,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "topk(15, max by (trip) (siano_trip_ops{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\", trip=~\"$trip\"}))", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "job": true, "instance": true, "hub": true, "__name__": true }, "renameByName": { "trip": "Trip", "Value": "Ops" } } },
        { "id": "sortBy", "options": { "fields": "", "sort": [ { "field": "Ops", "desc": true } ] } }
      ],
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false, "reducer": ["sum"], "fields": "" } },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Ops" }, "properties": [ { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }, { "id": "color", "value": { "mode": "continuous-GrYlRd" } } ] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Per-trip live connections",
      "description": "Total viewers of each trip (summed across hubs — a device connects to one hub).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 36 },
      "id": 22,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (trip) (siano_trip_connections{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\", trip=~\"$trip\"}) > 0", "legendFormat": "{{trip}}" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Per-trip op append rate",
      "description": "Write activity per trip, merged across hubs.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 45 },
      "id": 23,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (trip) (rate(siano_trip_ops_appended_total{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\", trip=~\"$trip\"}[$__rate_interval])) > 0", "legendFormat": "{{trip}}" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Process (per hub)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 53 },
      "id": 24,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Memory per hub (RSS & V8 heap)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 54 },
      "id": 25,
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max by (hub) (siano_process_resident_memory_bytes{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"})", "legendFormat": "{{hub}} rss" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max by (hub) (siano_process_heap_used_bytes{job=~\"$job\", instance=~\"$instance\", hub=~\"$hub\"})", "legendFormat": "{{hub}} heap" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 8, "showPoints": "never", "lineWidth": 2 }, "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*heap" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } } ] }
        ]
      }
    }
  ]
